{
  "opencollection": "1.0.0",
  "info": {
    "name": "SmartBear SwaggerHub APIs Organizations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Organization Members",
            "type": "http"
          },
          "http": {
            "method": "GET",
